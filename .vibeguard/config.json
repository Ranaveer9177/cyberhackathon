{
  "block_on": [
    "critical",
    "high"
  ],
  "scan_mode": "changed",
  "dependency_scan": true,
  "secret_scan": true,
  "source_scan": true,
  "report_format": "terminal",
  "fail_closed": true,
  "exclude": [
    ".git",
    ".vibeguard",
    "reports",
    "tests",
    "rules",
    "*.md",
    "*.markdown",
    "*.rst",
    "*.adoc"
  ]
}
